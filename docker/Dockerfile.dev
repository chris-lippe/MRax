FROM node:24.22.2-bookworm-slim AS node

FROM python:3.12-slim-trixie

COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PATH=/home/dev/.local/bin:$PATH \
    PYTHONPATH=/workspace \
    PLAYWRIGHT_BROWSERS_PATH=/opt/mrax-playwright

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        ffmpeg \
        fonts-dejavu-core \
        git \
        git-lfs \
        openssh-client \
        procps \
    && rm -rf /var/lib/apt/lists/*

# Install browsers and native dependencies as root, then use them as dev.
WORKDIR /tmp/mrax-frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund \
    && npx playwright install --with-deps chromium firefox webkit \
    && rm -rf /tmp/mrax-frontend /var/lib/apt/lists/*

WORKDIR /tmp/mrax-deps
COPY requirements.txt requirements-dev.txt ./
RUN python -m pip install --upgrade pip \
    && python -m pip install -r requirements-dev.txt \
    && rm -rf /tmp/mrax-deps

RUN useradd -ms /bin/bash dev
USER dev
WORKDIR /workspace

CMD ["/bin/bash"]
