{
  "format": "mrax.workflow",
  "kind": "fitting",
  "mrax_version": "0.4.0",
  "name": "T1: inversion recovery",
  "description": "Magnitude inversion-recovery fitting with ideal inversion.",
  "bindings": [],
  "steps": [
    {
      "id": "fit",
      "operation": "fit",
      "version": 1,
      "enabled": true,
      "settings": {
        "settings": {
          "model_name": "t1_ir",
          "optimizer_name": "auto",
          "num_steps": 600,
          "step_size": 0.02,
          "mask_fill_value": 0,
          "auto_mask_nan_observables": true,
          "compute_derived_maps": null,
          "selected_pools": [],
          "param_overrides": {},
          "pool_overrides": {},
          "regularizer_configs": {},
          "parameter_constant_dims": {}
        },
        "use_roi": false,
        "roi_names": null,
        "excluded_frames": []
      }
    }
  ],
  "extensions": {
    "org.mrax.preset": {
      "requirements": [
        "Magnitude inversion-recovery images spanning the recovery curve.",
        "At least three distinct TI values with valid time units.",
        "The model assumes ideal inversion.",
        "Whole-image fitting. Model parameter defaults come from the MRax parameter library."
      ]
    }
  }
}
