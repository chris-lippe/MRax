{
  "format": "mrax.workflow",
  "kind": "denoising",
  "mrax_version": "0.4.0",
  "name": "Spatial median filter",
  "description": "Remove isolated spatial outliers with a three-voxel median kernel.",
  "bindings": [],
  "steps": [
    {
      "id": "median",
      "operation": "process",
      "version": 1,
      "enabled": true,
      "settings": {
        "method": "median",
        "input": "image",
        "scope": "dataset",
        "parameters": {
          "size": 3,
          "mode": "reflect",
          "complex_mode": "real_imag"
        }
      }
    }
  ],
  "extensions": {
    "org.mrax.preset": {
      "requirements": [
        "Images with one to three spatial dimensions.",
        "The kernel spans each spatial axis. Small structures may also be affected."
      ]
    }
  }
}
