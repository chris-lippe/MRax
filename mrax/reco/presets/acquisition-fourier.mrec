{
  "format": "mrax.workflow",
  "format_version": 1,
  "kind": "reconstruction",
  "mrax_version": "0.4.0",
  "name": "Acquisition Fourier",
  "description": "Fourier reconstruction with the acquisition's configured corrections and output geometry.",
  "bindings": [],
  "steps": [
    {
      "id": "reconstruction",
      "operation": "reconstruct",
      "version": 1,
      "enabled": true,
      "settings": {
        "component": "magnitude",
        "pipeline": {
          "schema_version": 1,
          "name": "Acquisition Fourier",
          "encoding": "any",
          "stages": [
            {
              "kind": "profile_inversion",
              "enabled": true,
              "when": "configured",
              "options": {}
            },
            {
              "kind": "shift",
              "enabled": true,
              "when": "configured",
              "options": {}
            },
            {
              "kind": "readout_regrid",
              "enabled": true,
              "when": "configured",
              "options": {}
            },
            {
              "kind": "epi_phase",
              "enabled": true,
              "when": "configured",
              "options": {}
            },
            {
              "kind": "window",
              "enabled": true,
              "when": "configured",
              "options": {}
            },
            {
              "kind": "partial_fourier",
              "enabled": true,
              "when": "configured",
              "options": {}
            },
            {
              "kind": "gridding",
              "enabled": true,
              "when": "sampled",
              "options": {}
            },
            {
              "kind": "fft",
              "enabled": true,
              "when": "always",
              "options": {}
            },
            {
              "kind": "format",
              "enabled": true,
              "when": "always",
              "options": {}
            },
            {
              "kind": "combine",
              "enabled": true,
              "when": "always",
              "options": {}
            },
            {
              "kind": "product",
              "enabled": true,
              "when": "configured",
              "options": {}
            }
          ]
        }
      }
    }
  ],
  "extensions": {}
}
