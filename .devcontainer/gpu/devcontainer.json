{
  "name": "MRax development (NVIDIA GPU)",
  "build": {
    "dockerfile": "../../docker/Dockerfile.dev",
    "context": "../.."
  },
  "remoteUser": "dev",
  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
  "runArgs": ["--gpus=all"],
  "postCreateCommand": "bash .devcontainer/scripts/post-create.sh --gpu",
  "forwardPorts": [5173, 8765],
  "portsAttributes": {
    "5173": { "label": "MRax frontend development", "onAutoForward": "notify" },
    "8765": { "label": "MRax local browser GUI", "onAutoForward": "notify" }
  },
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["tests"],
        "isort.importStrategy": "fromEnvironment",
        "typescript.tsdk": "frontend/node_modules/typescript/lib"
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-toolsai.jupyter",
        "ms-azuretools.vscode-docker",
        "ms-playwright.playwright"
      ]
    }
  }
}
